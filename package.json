    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@octokit/app": "16.1.4",
    "@octokit/webhooks": "14.2.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "10.73.0",
    "@vercel/analytics": "2.0.1",
    "better-auth": "1.7.4",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "graphql": "16.14.2",
    "kyrielle": "2.9.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@graphql-codegen/cli": "7.4.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@graphql-eslint/eslint-plugin": "4.4.1",
    "@jujulego/jill": "3.0.11",
