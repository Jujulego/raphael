generator client {
  provider        = "prisma-client"
  output          = "../lib/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

model Installation {
  id            Int      @id
  accountIssuer String?
  accountId     String?
  account       Account? @relation(fields: [accountId, accountIssuer], references: [accountId, issuer], onDelete: Cascade)

  repositories RepositoriesOnInstallations[]
}

model Repository {
  owner      String
  name       String
  issueCount Int       @default(0)
  pushedAt   DateTime?

  installations RepositoriesOnInstallations[]
  pullRequests  PullRequest[]

  @@id([owner, name], name: "fullName")
}

view RepositoryStats {
  owner                String
  name                 String
  issueCount           Int
  pushedAt             DateTime?
  openPullRequestCount Int

  installations RepositoriesOnInstallations[]

  @@unique([owner, name], name: "fullName")
}

model PullRequest {
  repositoryOwner String
  repositoryName  String
  repository      Repository       @relation(fields: [repositoryOwner, repositoryName], references: [owner, name], onDelete: Cascade)
  number          Int
  title           String
  state           PullRequestState
  author          String
  createdAt       DateTime
  updatedAt       DateTime

  @@id([repositoryOwner, repositoryName, number], name: "fullNumber")
  @@index([repositoryOwner, repositoryName, state])
}

model RepositoriesOnInstallations {
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  installationId Int

  repository      Repository       @relation(fields: [repositoryOwner, repositoryName], references: [owner, name], onDelete: Cascade)
  repositoryStats RepositoryStats? @relation(fields: [repositoryOwner, repositoryName], references: [owner, name], map: "RepositoryStats_fkey")
  repositoryOwner String
  repositoryName  String

  @@id([installationId, repositoryOwner, repositoryName])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String         @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  installations         Installation[]

  @@unique([issuer, accountId], map: "Account_issuer_accountId_uidx")
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
